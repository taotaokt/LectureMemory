# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Packaging and coverage output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.DS_Store
.idea/
.vscode/

# Local model and Hugging Face caches
.cache/
models/
huggingface/

# Private lecture materials kept outside the managed data directory
lectureSlides/

# Generated application data
data/raw/**
data/rendered/**
data/embeddings/**
data/indexes/**
data/database/**
!data/raw/.gitkeep
!data/rendered/.gitkeep
!data/embeddings/.gitkeep
!data/indexes/.gitkeep
!data/database/.gitkeep

# Generated databases, indexes, and embedding arrays
*.db
*.sqlite
*.sqlite3
*.faiss
*.index
*.npy
*.npz

# Generated benchmark results
benchmark/results/**
!benchmark/results/.gitkeep
