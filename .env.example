# Copy this file to .env when local overrides are needed.

# Storage. Paths are resolved relative to the repository root unless absolute.
DATA_DIR=data
# DATABASE_PATH=data/database/lecture_memory.db
# RENDERED_DIR=data/rendered
# EMBEDDING_DIR=data/embeddings
# INDEX_DIR=data/indexes

# Model execution. Install the optional runtime with: pip install -e '.[qwen]'
DEVICE=auto
MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_DTYPE=auto
EMBEDDING_DIMENSION=2048
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_PIXELS=524288
EMBEDDING_QUERY_INSTRUCTION=Retrieve the lecture slide image or note most relevant to the user's query.
RERANKER_MODEL_NAME=Qwen/Qwen3-VL-Reranker-2B
RERANKER_DTYPE=auto
RERANKER_BATCH_SIZE=1
RERANKER_MAX_LENGTH=10240
RERANKER_MIN_PIXELS=4096
RERANKER_MAX_PIXELS=524288
RERANKER_INSTRUCTION=Retrieve the lecture slide image or note most relevant to the user's query.

# Search pipeline. Keep FINAL_TOP_K <= RERANK_TOP_K <= RETRIEVAL_TOP_K.
RETRIEVAL_TOP_K=20
RERANK_TOP_K=20
FINAL_TOP_K=5
